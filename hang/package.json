{
  "name": "hang-rack",
  "version": "0.1.0",
  "private": true,
  "description": "HANG / ハング — ハンガーラックから服を選ぶファッションサイトのサンプル",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "test": "vitest run",
    "e2e": "node e2e/check.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.20",
    "vitest": "2.1.9"
  }
}
